+#include "stdafx.h"
+#include "UiTheming.h"
+#include "CoreInterface.h"
+#include "DisplayWindow/DisplayWindow.h"
+#include "ShellBrowser/ShellBrowser.h"
+#include "Tab.h"
+#include "TabContainer.h"
+#include <algorithm>
+#include <dwmapi.h>
+#include <uxtheme.h>
+
+UiTheming::UiTheming(IExplorerplusplus *expp, TabContainer *tabContainer) :
+	m_expp(expp),
+	m_tabContainer(tabContainer),
+	m_customListViewColorsApplied(false)
+{
+	m_connections.emplace_back(m_tabContainer->tabCreatedSignal.AddObserver(boost::bind(&UiTheming::OnTabCreated, this, _1, _2)));
+
+	InitializeDarkAppearance();
+}
+
+UiTheming::~UiTheming()
+{
+	// Window subclasses must not retain a pointer to a destroyed UiTheming instance.
+	for (HWND hwnd : m_themeWindows)
+	{
+		if (IsWindow(hwnd))
+		{
+			RemoveWindowSubclass(hwnd, ThemeWindowProc, 0xE140);
+		}
+	}
+
+	if (m_darkBackgroundBrush)
+	{
+		DeleteObject(m_darkBackgroundBrush);
+	}
+	if (m_darkHoverBrush)
+	{
+		DeleteObject(m_darkHoverBrush);
+	}
+}
+
+void UiTheming::OnTabCreated(int tabId, BOOL switchToNewTab)
+{
+	UNREFERENCED_PARAMETER(switchToNewTab);
+
+	const Tab &tab = m_tabContainer->GetTab(tabId);
+
+	if (m_customListViewColorsApplied)
+	{
+		ApplyListViewColorsForTab(tab, m_listViewBackgroundColor, m_listViewTextColor);
+		ApplyDarkAppearanceToWindow(tab.GetShellBrowser()->GetListView());
+		EnumChildWindows(tab.GetShellBrowser()->GetListView(), EnumChildThemeProc,
+			reinterpret_cast<LPARAM>(this));
+	}
+}
+
+bool UiTheming::SetListViewColors(COLORREF backgroundColor, COLORREF textColor)
+{
+	m_customListViewColorsApplied = true;
+	m_listViewBackgroundColor = backgroundColor;
+	m_listViewTextColor = textColor;
+
+	bool res = ApplyListViewColorsForAllTabs(backgroundColor, textColor);
+
+	return res;
+}
+
+bool UiTheming::ApplyListViewColorsForAllTabs(COLORREF backgroundColor, COLORREF textColor)
+{
+	bool overallResult = true;
+
+	for (const auto &item : m_tabContainer->GetAllTabs())
+	{
+		bool res = ApplyListViewColorsForTab(*item.second, backgroundColor, textColor);
+
+		if (!res)
+		{
+			overallResult = false;
+		}
+	}
+
+	return overallResult;
+}
+
+bool UiTheming::ApplyListViewColorsForTab(const Tab &tab, COLORREF backgroundColor, COLORREF textColor)
+{
+	BOOL bkRes = ListView_SetBkColor(tab.GetShellBrowser()->GetListView(), backgroundColor);
+	BOOL textBkRes = ListView_SetTextBkColor(tab.GetShellBrowser()->GetListView(), backgroundColor);
+	BOOL textRes = ListView_SetTextColor(tab.GetShellBrowser()->GetListView(), textColor);
+
+	InvalidateRect(tab.GetShellBrowser()->GetListView(), nullptr, TRUE);
+
+	if (!bkRes || !textBkRes || !textRes)
+	{
+		return false;
+	}
+
+	return true;
+}
+
+void UiTheming::SetTreeViewColors(COLORREF backgroundColor, COLORREF textColor)
+{
+	TreeView_SetBkColor(m_expp->GetTreeView(), backgroundColor);
+	TreeView_SetTextColor(m_expp->GetTreeView(), textColor);
+
+	InvalidateRect(m_expp->GetTreeView(), nullptr, TRUE);
+}
+
+// -----------------------------------------------------------------------------
+// Explorer++ 1.4.0 dark appearance experiment (NOT the 1.5 theme implementation).
+// Intentionally avoids process injection, API detours, registry edits or changes
+// to the shell / file-operation code.  Windows 11 is the intended test platform.
+// -----------------------------------------------------------------------------
+namespace
+{
+constexpr COLORREF DARK_BACKGROUND = RGB(32, 32, 32);
+constexpr COLORREF DARK_PANEL = RGB(44, 44, 44);
+constexpr COLORREF DARK_FOREGROUND = RGB(233, 233, 233);
+constexpr COLORREF DARK_HOVER = RGB(61, 61, 61);
+
+// On Windows 10 1903+ these are undocumented uxtheme exports.  Resolve at
+// runtime and degrade gracefully when they aren't present.  They are used by
+// Explorer++ 1.5 too, but no source from that version is copied here.
+using SetPreferredAppModeFn = int (WINAPI *)(int);
+using FlushMenuThemesFn = void (WINAPI *)();
+using RefreshImmersiveColorPolicyStateFn = void (WINAPI *)();
+using AllowDarkModeForWindowFn = bool (WINAPI *)(HWND, bool);
+AllowDarkModeForWindowFn g_allowDarkModeForWindow = nullptr;
+
+bool CanApplyExperimentalDarkTheme()
+{
+	// Avoid calling ordinal 135 on Windows 10 1809, where it has a different API.
+	using RtlGetVersionFn = LONG (WINAPI *)(OSVERSIONINFOW *);
+	auto rtlGetVersion = reinterpret_cast<RtlGetVersionFn>(
+		GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "RtlGetVersion"));
+	OSVERSIONINFOW version = {};
+	version.dwOSVersionInfoSize = sizeof(version);
+	if (!rtlGetVersion || rtlGetVersion(&version) != 0
+		|| version.dwMajorVersion != 10 || version.dwBuildNumber < 18362)
+	{
+		return false;
+	}
+
+	HIGHCONTRAST highContrast = {};
+	highContrast.cbSize = sizeof(highContrast);
+	if (SystemParametersInfo(SPI_GETHIGHCONTRAST, sizeof(highContrast), &highContrast, 0)
+		&& (highContrast.dwFlags & HCF_HIGHCONTRASTON))
+	{
+		return false;
+	}
+
+	return true;
+}
+
+void InitializeNativeDarkMode()
+{
+	HMODULE uxTheme = GetModuleHandleW(L"uxtheme.dll");
+	if (!uxTheme)
+	{
+		uxTheme = LoadLibraryW(L"uxtheme.dll");
+	}
+	if (!uxTheme)
+	{
+		return;
+	}
+
+	auto setPreferredAppMode = reinterpret_cast<SetPreferredAppModeFn>(
+		GetProcAddress(uxTheme, MAKEINTRESOURCEA(135)));
+	g_allowDarkModeForWindow = reinterpret_cast<AllowDarkModeForWindowFn>(
+		GetProcAddress(uxTheme, MAKEINTRESOURCEA(133)));
+	auto flushMenuThemes = reinterpret_cast<FlushMenuThemesFn>(
+		GetProcAddress(uxTheme, MAKEINTRESOURCEA(136)));
+	auto refreshPolicy = reinterpret_cast<RefreshImmersiveColorPolicyStateFn>(
+		GetProcAddress(uxTheme, MAKEINTRESOURCEA(104)));
+	if (setPreferredAppMode)
+	{
+		// 2 == ForceDark on Windows 10 1903+; this changes the current process only.
+		setPreferredAppMode(2);
+	}
+	if (flushMenuThemes)
+	{
+		flushMenuThemes();
+	}
+	if (refreshPolicy)
+	{
+		refreshPolicy();
+	}
+}
+
+bool IsClass(HWND hwnd, LPCWSTR name)
+{
+	WCHAR className[256] = {};
+	return GetClassNameW(hwnd, className, 256) != 0 && lstrcmpW(className, name) == 0;
+}
+}
+
+void UiTheming::InitializeDarkAppearance()
+{
+	if (!CanApplyExperimentalDarkTheme())
+	{
+		return;
+	}
+
+	m_darkBackgroundBrush = CreateSolidBrush(DARK_BACKGROUND);
+	m_darkHoverBrush = CreateSolidBrush(DARK_HOVER);
+	if (!m_darkBackgroundBrush)
+	{
+		return;
+	}
+
+	InitializeNativeDarkMode();
+
+	HWND mainWindow = m_expp->GetMainWindow();
+	if (mainWindow)
+	{
+		// Attribute 20 is DWMWA_USE_IMMERSIVE_DARK_MODE on Windows 11.
+		BOOL dark = TRUE;
+		DwmSetWindowAttribute(mainWindow, static_cast<DWMWINDOWATTRIBUTE>(20),
+			&dark, sizeof(dark));
+		ApplyDarkAppearanceToWindow(mainWindow);
+		EnumChildWindows(mainWindow, EnumChildThemeProc, reinterpret_cast<LPARAM>(this));
+
+		// Only the top-level menu bar is owner-drawn. Dropdown menus remain
+		// native so keyboard navigation, accessibility and shell extensions
+		// are not reimplemented. The process dark mode request above asks
+		// Windows itself to render the dropdowns dark where supported.
+		HMENU mainMenu = GetMenu(mainWindow);
+		if (mainMenu)
+		{
+			const int count = GetMenuItemCount(mainMenu);
+			for (int index = 0; index < count; ++index)
+			{
+				MENUITEMINFOW item = {};
+				item.cbSize = sizeof(item);
+				item.fMask = MIIM_FTYPE;
+				if (!GetMenuItemInfoW(mainMenu, index, TRUE, &item))
+				{
+					continue;
+				}
+				item.fMask = MIIM_FTYPE | MIIM_DATA;
+				item.fType |= MFT_OWNERDRAW;
+				item.dwItemData = static_cast<ULONG_PTR>(index);
+				SetMenuItemInfoW(mainMenu, index, TRUE, &item);
+			}
+			MENUINFO menuInfo = {};
+			menuInfo.cbSize = sizeof(menuInfo);
+			menuInfo.fMask = MIM_BACKGROUND;
+			menuInfo.hbrBack = m_darkBackgroundBrush;
+			SetMenuInfo(mainMenu, &menuInfo);
+			DrawMenuBar(mainWindow);
+		}
+
+	}
+
+	SetListViewColors(DARK_BACKGROUND, DARK_FOREGROUND);
+	SetTreeViewColors(DARK_BACKGROUND, DARK_FOREGROUND);
+}
+
+BOOL CALLBACK UiTheming::EnumChildThemeProc(HWND hwnd, LPARAM data)
+{
+	auto *self = reinterpret_cast<UiTheming *>(data);
+	self->ApplyDarkAppearanceToWindow(hwnd);
+	return TRUE;
+}
+
+void UiTheming::SubclassThemeWindow(HWND hwnd)
+{
+	if (!hwnd)
+	{
+		return;
+	}
+	if (std::find(m_themeWindows.begin(), m_themeWindows.end(), hwnd) != m_themeWindows.end())
+	{
+		return;
+	}
+
+	if (SetWindowSubclass(hwnd, ThemeWindowProc, 0xE140, reinterpret_cast<DWORD_PTR>(this)))
+	{
+		m_themeWindows.push_back(hwnd);
+	}
+}
+
+void UiTheming::ApplyDarkAppearanceToWindow(HWND hwnd)
+{
+	if (!hwnd)
+	{
+		return;
+	}
+
+	if (g_allowDarkModeForWindow)
+	{
+		g_allowDarkModeForWindow(hwnd, true);
+	}
+
+	if (IsClass(hwnd, WC_LISTVIEW))
+	{
+		SetWindowTheme(hwnd, L"ItemsView", nullptr);
+		ListView_SetBkColor(hwnd, DARK_BACKGROUND);
+		ListView_SetTextBkColor(hwnd, DARK_BACKGROUND);
+		ListView_SetTextColor(hwnd, DARK_FOREGROUND);
+	}
+	else if (IsClass(hwnd, WC_TREEVIEW))
+	{
+		SetWindowTheme(hwnd, L"Explorer", nullptr);
+		TreeView_SetBkColor(hwnd, DARK_BACKGROUND);
+		TreeView_SetTextColor(hwnd, DARK_FOREGROUND);
+		TreeView_SetInsertMarkColor(hwnd, DARK_FOREGROUND);
+	}
+	else if (IsClass(hwnd, WC_HEADER))
+	{
+		SetWindowTheme(hwnd, L"ItemsView", nullptr);
+	}
+	else if (IsClass(hwnd, REBARCLASSNAME))
+	{
+		SendMessage(hwnd, RB_SETBKCOLOR, 0, DARK_PANEL);
+		SendMessage(hwnd, RB_SETTEXTCOLOR, 0, DARK_FOREGROUND);
+	}
+	else if (IsClass(hwnd, TOOLBARCLASSNAME))
+	{
+		SendMessage(hwnd, TB_SETINSERTMARKCOLOR, 0, DARK_FOREGROUND);
+	}
+	else if (IsClass(hwnd, STATUSCLASSNAME))
+	{
+		SendMessage(hwnd, SB_SETBKCOLOR, 0, DARK_PANEL);
+		SetWindowTheme(hwnd, nullptr, L"ExplorerStatusBar");
+	}
+	else if (IsClass(hwnd, WC_COMBOBOX) || IsClass(hwnd, WC_COMBOBOXEX))
+	{
+		SetWindowTheme(hwnd, L"CFD", nullptr);
+	}
+	else if (IsClass(hwnd, WC_EDIT))
+	{
+		SetWindowTheme(hwnd, L"CFD", nullptr);
+	}
+	else if (IsClass(hwnd, L"DisplayWindow"))
+	{
+		// The classic information pane paints its own blue gradient. These
+		// existing messages ask it to render dark without changing its logic.
+		SendMessage(hwnd, DWM_SETCENTRECOLOR, DARK_PANEL, 0);
+		SendMessage(hwnd, DWM_SETSURROUNDCOLOR, DARK_BACKGROUND, 0);
+		DisplayWindow_SetTextColor(hwnd, DARK_FOREGROUND);
+	}
+
+	// Style parent-held backgrounds, labels, and toolbar custom draw without
+	// subclassing any filesystem-related operations.
+	SubclassThemeWindow(hwnd);
+}
+
+LRESULT CALLBACK UiTheming::ThemeWindowProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam,
+	UINT_PTR subclassId, DWORD_PTR data)
+{
+	UNREFERENCED_PARAMETER(subclassId);
+	auto *self = reinterpret_cast<UiTheming *>(data);
+
+	switch (msg)
+	{
+	case WM_MEASUREITEM:
+	{
+		if (hwnd != self->m_expp->GetMainWindow()) { break; }
+		auto *item = reinterpret_cast<MEASUREITEMSTRUCT *>(lParam);
+		if (!item || item->CtlType != ODT_MENU) { break; }
+		HMENU menu = GetMenu(hwnd);
+		if (!menu || item->itemData >= static_cast<ULONG_PTR>(GetMenuItemCount(menu))) { break; }
+		WCHAR text[256] = {};
+		GetMenuStringW(menu, static_cast<UINT>(item->itemData), text, 256, MF_BYPOSITION);
+		HDC dc = GetDC(hwnd);
+		if (!dc) { break; }
+		NONCLIENTMETRICSW metrics = {};
+		metrics.cbSize = sizeof(metrics);
+		HFONT font = nullptr;
+		if (SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(metrics), &metrics, 0))
+		{
+			font = CreateFontIndirectW(&metrics.lfMenuFont);
+		}
+		HGDIOBJ previousFont = font ? SelectObject(dc, font) : nullptr;
+		SIZE size = {};
+		GetTextExtentPoint32W(dc, text, lstrlenW(text), &size);
+		if (previousFont) { SelectObject(dc, previousFont); }
+		if (font) { DeleteObject(font); }
+		ReleaseDC(hwnd, dc);
+		item->itemWidth = size.cx + 16;
+		item->itemHeight = (size.cy + 6 > GetSystemMetrics(SM_CYMENU) - 2) ? (size.cy + 6) : (GetSystemMetrics(SM_CYMENU) - 2);
+		return TRUE;
+	}
+	case WM_DRAWITEM:
+	{
+		if (hwnd != self->m_expp->GetMainWindow()) { break; }
+		auto *item = reinterpret_cast<DRAWITEMSTRUCT *>(lParam);
+		if (!item || item->CtlType != ODT_MENU) { break; }
+		HMENU menu = GetMenu(hwnd);
+		if (!menu || item->itemData >= static_cast<ULONG_PTR>(GetMenuItemCount(menu))) { break; }
+		WCHAR text[256] = {};
+		GetMenuStringW(menu, static_cast<UINT>(item->itemData), text, 256, MF_BYPOSITION);
+		const bool highlighted = (item->itemState & (ODS_SELECTED | ODS_HOTLIGHT)) != 0;
+		FillRect(item->hDC, &item->rcItem,
+			highlighted && self->m_darkHoverBrush ? self->m_darkHoverBrush : self->m_darkBackgroundBrush);
+		SetBkMode(item->hDC, TRANSPARENT);
+		SetTextColor(item->hDC, (item->itemState & (ODS_DISABLED | ODS_GRAYED))
+			? RGB(135, 135, 135) : DARK_FOREGROUND);
+		UINT flags = DT_CENTER | DT_VCENTER | DT_SINGLELINE;
+		if (item->itemState & ODS_NOACCEL) { flags |= DT_HIDEPREFIX; }
+		DrawTextW(item->hDC, text, -1, &item->rcItem, flags);
+		return TRUE;
+	}
+	case WM_CTLCOLORSTATIC:
+	case WM_CTLCOLORBTN:
+	case WM_CTLCOLOREDIT:
+	case WM_CTLCOLORLISTBOX:
+	{
+		HDC dc = reinterpret_cast<HDC>(wParam);
+		SetTextColor(dc, DARK_FOREGROUND);
+		SetBkColor(dc, DARK_BACKGROUND);
+		return reinterpret_cast<LRESULT>(self->m_darkBackgroundBrush);
+	}
+
+	case WM_ERASEBKGND:
+		if (IsClass(hwnd, WC_STATIC) || IsClass(hwnd, REBARCLASSNAME)
+			|| IsClass(hwnd, TOOLBARCLASSNAME))
+		{
+			RECT rect;
+			GetClientRect(hwnd, &rect);
+			FillRect(reinterpret_cast<HDC>(wParam), &rect, self->m_darkBackgroundBrush);
+			return TRUE;
+		}
+		break;
+
+	case WM_NOTIFY:
+	{
+		const auto *header = reinterpret_cast<const NMHDR *>(lParam);
+		if (!header || header->code != NM_CUSTOMDRAW
+			|| !IsClass(header->hwndFrom, TOOLBARCLASSNAME))
+		{
+			break;
+		}
+
+		auto *draw = reinterpret_cast<NMTBCUSTOMDRAW *>(lParam);
+		if (draw->nmcd.dwDrawStage == CDDS_PREPAINT)
+		{
+			return CDRF_NOTIFYITEMDRAW;
+		}
+		if (draw->nmcd.dwDrawStage == CDDS_ITEMPREPAINT)
+		{
+			draw->clrText = DARK_FOREGROUND;
+			draw->clrBtnFace = DARK_PANEL;
+			draw->clrHighlightHotTrack = DARK_HOVER;
+			draw->clrTextHighlight = DARK_FOREGROUND;
+			return TBCDRF_USECDCOLORS;
+		}
+		break;
+	}
+
+	case WM_NCDESTROY:
+		RemoveWindowSubclass(hwnd, ThemeWindowProc, 0xE140);
+		self->m_themeWindows.erase(
+			std::remove(self->m_themeWindows.begin(), self->m_themeWindows.end(), hwnd),
+			self->m_themeWindows.end());
+		break;
+	}
+
+	return DefSubclassProc(hwnd, msg, wParam, lParam);
+}
